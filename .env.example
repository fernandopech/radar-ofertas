# Copie para .env e preencha. O .env nunca vai pro Git.

# --- Telegram (sua conta, SÓ LEITURA) ---
# Gere em https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Preenchido automaticamente por: python -m scripts.login_telegram
# Dá acesso total à sua conta: trate como senha.
TELEGRAM_SESSION=
# Canais a escutar, separados por vírgula (username sem @ ou id numérico).
# Descubra com: python -m scripts.listar_canais
TELEGRAM_CANAIS=

# --- Anthropic (etapas 4 e 5) ---
ANTHROPIC_API_KEY=

# --- Supabase (etapa 6) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (sb_secret_...): Supabase -> Project Settings -> API Keys -> Secret keys.
# Nunca a publishable. Dá acesso total ao banco: trate como senha.
SUPABASE_KEY=

# --- Bot de notificação (etapa 7) ---
# Token do @BotFather. Dá controle total do bot: trate como senha.
BOT_TOKEN=
# Preenchido por: python -m scripts.configurar_bot (depois de mandar /start pro bot)
BOT_CHAT_ID=

# --- Deploy (etapa 9) ---
# Heroku → Account Settings → API Key. Só usada no Codespace pelo scripts/deploy_heroku.sh;
# não vai para o Heroku. Dá acesso total à conta: trate como senha.
HEROKU_API_KEY=

# --- OLX (API omkarcloud no RapidAPI, plano grátis de 1.000 consultas/mês) ---
# rapidapi.com → API "best-olx-brazil-scraper-free-1000-calls" → campo X-RapidAPI-Key.
RAPIDAPI_KEY=
